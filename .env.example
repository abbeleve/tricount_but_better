# ---------------------------------------------------------------- core
ENVIRONMENT=prod
# One SQLite file. Back it up by copying it (see deploy/README.md).
DATABASE_URL=sqlite:///var/tricount.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=https://split.example.com
DEFAULT_CURRENCY=RUB

# --------------------------------------------------------------- photos
MAX_UPLOAD_MB=12
MAX_RECEIPT_IMAGES=8

# ------------------------------------------------------------------- VLM
# polza        -> Polza OpenAI-compatible API, authenticates with POLZA_API_KEY
# disabled     -> receipt scanning off; the button disappears from the UI
VLM_PROVIDER=polza
VLM_MODEL=qwen/qwen3.5-9b
VLM_TIMEOUT_SECONDS=180
POLZA_API_KEY=
