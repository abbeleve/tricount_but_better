# ---------------------------------------------------------------- core
ENVIRONMENT=prod
# One SQLite file. Back it up by copying it (see deploy/README.md).
DATABASE_URL=sqlite:///var/tricount.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=https://split.example.com
DEFAULT_CURRENCY=RUB

# --------------------------------------------------------------- uploads
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=12
MAX_RECEIPT_IMAGES=8

# ------------------------------------------------------------------- VLM
# agent_sdk    -> claude-agent-sdk, authenticates with CLAUDE_CODE_OAUTH_TOKEN
# messages_api -> anthropic SDK, authenticates with ANTHROPIC_API_KEY
# disabled     -> receipt scanning off; the button disappears from the UI
VLM_PROVIDER=agent_sdk
VLM_MODEL=claude-sonnet-5
VLM_TIMEOUT_SECONDS=180
VLM_MAX_COST_USD=0.50

CLAUDE_CODE_OAUTH_TOKEN=
# Absolute path to the `claude` binary if it is not on the service's PATH.
CLAUDE_CLI_PATH=
# Local development only: use whatever the CLI is already logged in as.
CLAUDE_USE_AMBIENT_LOGIN=false

# ---------------------------------------------------- egress / geo-routing
# Set AT MOST ONE of these. Leave both empty when a WireGuard tunnel already
# covers the whole process. See deploy/README.md for all three options.
#
# (a) HTTP or SOCKS5 proxy -- needs the "socks" extra for socks5://
# ANTHROPIC_PROXY_URL=socks5://user:pass@vpn-host:1080
#
# (b) A reverse-proxy relay you run outside the blocked region
# ANTHROPIC_BASE_URL=https://relay.example.com
