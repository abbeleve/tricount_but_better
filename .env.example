# ---------------------------------------------------------------- core
ENVIRONMENT=prod
# One SQLite file. Back it up by copying it (see deploy/README.md).
DATABASE_URL=sqlite:///var/tricount.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=https://split.example.com
DEFAULT_CURRENCY=RUB

# --------------------------------------------------------------- photos
MAX_UPLOAD_MB=12
MAX_RECEIPT_IMAGES=8

# ------------------------------------------------------------------- VLM
# Polza is always the receipt parser. Set its API key to enable scanning.
VLM_MODEL=qwen/qwen3.5-9b
VLM_TIMEOUT_SECONDS=180
POLZA_API_KEY=
# Alternatively, put the key in this file (excluded from deployment sync):
# POLZA_API_KEY_FILE=.secrets/polza_api_key

# ------------------------------------------------------------- web push
# Optional. Unset, the push signing key is derived from JWT_SECRET and the
# contact is the first https CORS origin. See deploy/README.md.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
